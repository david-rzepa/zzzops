{
  "schema": 1,
  "graphs": {
    "default": {
      "terminal": [
        "merge"
      ],
      "nodes": {
        "design": {
          "description": "Write the design for the goal, in light of its dependencies' reviewed designs.",
          "kind": "agent",
          "root": false,
          "capability": "architectural",
          "prompt": "design.md",
          "stage": "discovery",
          "inputs": {
            "spec": {
              "from": "goal.spec"
            },
            "dep_designs": {
              "from": "deps.design.doc"
            },
            "dep_reviews": {
              "from": "deps.filter_design.summary",
              "context": true,
              "optional": true
            }
          },
          "outputs": {
            "summary": "text",
            "doc": "artifact"
          },
          "instructions": [
            "workflow",
            "rigor",
            "communication",
            "owner_questions"
          ]
        },
        "review_design": {
          "description": "Design review through seven lenses (intent, simplicity, truth, adversary, concurrency, rollout, experience), one pass per lens.",
          "kind": "agent",
          "capability": "reasoning",
          "prompt": "review.md",
          "stage": "discovery",
          "skippable": false,
          "review": {
            "subject": "design",
            "filter": "filter_design"
          },
          "inputs": {
            "spec": {
              "from": "goal.spec"
            },
            "doc": {
              "from": "design.doc"
            }
          },
          "policy": [
            "intent"
          ],
          "instructions": [
            "review",
            "communication",
            "owner_questions"
          ],
          "lenses": {
            "intent": {
              "prompt": "lens_intent.md",
              "skippable": false
            },
            "simplicity": {
              "prompt": "lens_simplicity.md",
              "skippable": false
            },
            "truth": {
              "prompt": "lens_truth.md"
            },
            "adversary": {
              "prompt": "lens_adversary.md"
            },
            "concurrency": {
              "prompt": "lens_concurrency.md"
            },
            "rollout": {
              "prompt": "lens_rollout.md"
            },
            "experience": {
              "prompt": "lens_experience.md"
            }
          }
        },
        "adversary_design": {
          "description": "Adversary lens on the design: how could it harm someone, or be broken or gamed?",
          "kind": "agent",
          "capability": "reasoning",
          "prompt": "lens_adversary.md",
          "stage": "discovery",
          "review": {
            "subject": "design",
            "filter": "filter_design"
          },
          "inputs": {
            "spec": {
              "from": "goal.spec"
            },
            "doc": {
              "from": "design.doc"
            }
          },
          "instructions": [
            "review",
            "communication",
            "owner_questions"
          ]
        },
        "filter_design": {
          "description": "Independent filter of the design reviewers' findings: judges every note keep or note, and joins the reviewers into one reopen per round.",
          "kind": "agent",
          "capability": "bounded",
          "prompt": "filter.md",
          "stage": "discovery",
          "skippable": false,
          "inputs": {
            "spec": {
              "from": "goal.spec"
            },
            "doc": {
              "from": "design.doc"
            },
            "review": {
              "from": "review_design.summary"
            },
            "adversary": {
              "from": "adversary_design.summary",
              "optional": true
            }
          },
          "outputs": {
            "summary": "text",
            "verdicts": "object"
          },
          "instructions": [
            "communication"
          ]
        },
        "approve_design": {
          "description": "The human approves the design (skip per goal for small, low-risk goals).",
          "kind": "human",
          "prompt": "approve_design.md",
          "stage": "discovery",
          "review": {
            "subject": "design"
          },
          "inputs": {
            "summary": {
              "from": "design.summary"
            },
            "doc": {
              "from": "design.doc"
            },
            "filter": {
              "from": "filter_design.summary"
            },
            "review": {
              "from": "review_design.summary",
              "context": true
            },
            "adversary": {
              "from": "adversary_design.summary",
              "context": true,
              "optional": true
            }
          }
        },
        "base": {
          "description": "Put the goal's own commits on its stack base: the integration branch, one unmerged dependency's PR head, or a combine commit of several.",
          "kind": "op",
          "op": "git.base",
          "workspace": true,
          "stage": "delivery",
          "inputs": {
            "heads": {
              "from": "deps.integrate.pr.head",
              "optional": true
            },
            "prs": {
              "from": "deps.integrate.pr",
              "context": true,
              "optional": true
            },
            "merges": {
              "from": "deps.merge.merge_commit",
              "optional": true,
              "pending": true
            },
            "filter": {
              "from": "filter_design.summary",
              "context": true
            },
            "approval": {
              "from": "approve_design.summary",
              "context": true,
              "optional": true
            }
          },
          "outputs": {
            "branch": "string",
            "base_commit": "sha",
            "stack": "list",
            "replay_map": "object",
            "replay_pos": "object"
          }
        },
        "test_design": {
          "description": "Write the tests and the commands that run them.",
          "kind": "agent",
          "capability": "reasoning",
          "prompt": "test_design.md",
          "workspace": true,
          "stage": "delivery",
          "inputs": {
            "doc": {
              "from": "design.doc"
            },
            "base": {
              "from": "base.base_commit"
            }
          },
          "outputs": {
            "tests": "checkpoint",
            "commands": "strings",
            "cost": "object"
          },
          "instructions": [
            "verification"
          ]
        },
        "review_tests": {
          "description": "Independent review of the tests against the design.",
          "kind": "agent",
          "capability": "reasoning",
          "prompt": "review_tests.md",
          "stage": "delivery",
          "review": {
            "subject": "test_design"
          },
          "inputs": {
            "doc": {
              "from": "design.doc"
            },
            "tests": {
              "from": "test_design.tests.change"
            },
            "cost": {
              "from": "test_design.cost",
              "context": true
            }
          },
          "instructions": [
            "verification"
          ]
        },
        "implement": {
          "description": "Implement the design so the accepted tests pass, without changing them.",
          "kind": "agent",
          "capability": "bounded",
          "prompt": "implement.md",
          "workspace": true,
          "stage": "delivery",
          "inputs": {
            "doc": {
              "from": "design.doc"
            },
            "tests": {
              "from": "test_design.tests.change"
            },
            "base": {
              "from": "base.base_commit"
            },
            "commands": {
              "from": "test_design.commands",
              "context": true
            },
            "tests_review": {
              "from": "review_tests.summary",
              "context": true
            }
          },
          "preserve": "test_design",
          "outputs": {
            "code": "checkpoint",
            "summary": "text"
          },
          "instructions": [
            "code_quality",
            "dependencies",
            "security",
            "git"
          ]
        },
        "run_tests": {
          "description": "Run the goal's test commands and the repository's verification commands on the exact code tree.",
          "kind": "op",
          "op": "checks.run",
          "workspace": true,
          "stage": "delivery",
          "inputs": {
            "code": {
              "from": "implement.code.tree"
            },
            "commands": {
              "from": "test_design.commands"
            }
          },
          "policy": [
            "verification.commands",
            "verification"
          ],
          "outputs": {
            "result": "object"
          }
        },
        "review_impl": {
          "description": "Implementation review through five lenses (compliance, correctness, missing, tests, craft), one pass per lens.",
          "kind": "agent",
          "capability": "reasoning",
          "prompt": "review.md",
          "stage": "delivery",
          "skippable": false,
          "review": {
            "subject": "implement",
            "filter": "filter_impl"
          },
          "inputs": {
            "doc": {
              "from": "design.doc"
            },
            "tests": {
              "from": "test_design.tests.change"
            },
            "code": {
              "from": "implement.code.change"
            },
            "checks": {
              "from": "run_tests.result",
              "context": true
            },
            "cost": {
              "from": "test_design.cost",
              "context": true
            },
            "base": {
              "from": "base.base_commit"
            }
          },
          "instructions": [
            "review",
            "communication",
            "security",
            "code_quality",
            "owner_questions"
          ],
          "lenses": {
            "compliance": {
              "prompt": "lens_compliance.md",
              "skippable": false
            },
            "correctness": {
              "prompt": "lens_correctness.md"
            },
            "missing": {
              "prompt": "lens_missing.md",
              "skippable": false
            },
            "tests": {
              "prompt": "lens_tests.md"
            },
            "craft": {
              "prompt": "lens_craft.md",
              "skippable": false
            }
          }
        },
        "filter_impl": {
          "description": "Independent filter of the implementation reviewer's findings: judges every note keep or note.",
          "kind": "agent",
          "capability": "bounded",
          "prompt": "filter.md",
          "stage": "delivery",
          "skippable": false,
          "inputs": {
            "doc": {
              "from": "design.doc"
            },
            "code": {
              "from": "implement.code.change"
            },
            "review": {
              "from": "review_impl.summary"
            }
          },
          "outputs": {
            "summary": "text",
            "verdicts": "object"
          },
          "instructions": [
            "communication"
          ]
        },
        "integrate": {
          "description": "Build the review-free PR branch, open, update or retarget the PR, and read its required checks.",
          "kind": "op",
          "op": "git.integrate",
          "workspace": true,
          "stage": "delivery",
          "inputs": {
            "code": {
              "from": "implement.code.tree"
            },
            "base": {
              "from": "base.base_commit"
            },
            "stack": {
              "from": "base.stack",
              "context": true
            },
            "filter": {
              "from": "filter_impl.summary",
              "context": true
            },
            "review": {
              "from": "review_impl.summary",
              "context": true
            },
            "summary": {
              "from": "design.summary",
              "context": true
            },
            "checks": {
              "from": "run_tests.result",
              "context": true
            }
          },
          "policy": [
            "verification.required_ci"
          ],
          "outputs": {
            "pr": "object",
            "ci": "object"
          }
        },
        "approve_merge": {
          "description": "The human decides to merge.",
          "kind": "human",
          "prompt": "approve_merge.md",
          "stage": "delivery",
          "skippable": false,
          "review": {
            "subject": "implement"
          },
          "inputs": {
            "code": {
              "from": "implement.code.change"
            },
            "summary": {
              "from": "implement.summary",
              "context": true
            },
            "design_summary": {
              "from": "design.summary",
              "context": true
            },
            "tests_review": {
              "from": "review_tests.summary",
              "context": true
            },
            "filter": {
              "from": "filter_impl.summary",
              "context": true
            },
            "review": {
              "from": "review_impl.summary",
              "context": true
            },
            "checks": {
              "from": "run_tests.result",
              "context": true
            }
          }
        },
        "merge": {
          "description": "Merge the PR at the expected head, once every dependency has merged.",
          "kind": "op",
          "op": "github.merge",
          "stage": "delivery",
          "release_gate": true,
          "inputs": {
            "pr": {
              "from": "integrate.pr"
            },
            "approval": {
              "from": "approve_merge.summary",
              "context": true
            },
            "dep_merges": {
              "from": "deps.merge.merge_commit",
              "context": true,
              "optional": true
            },
            "base": {
              "from": "base.base_commit",
              "context": true
            },
            "issue": {
              "from": "goal.links.issue",
              "context": true
            }
          },
          "outputs": {
            "merge_commit": "sha",
            "merged_at": "string"
          }
        }
      }
    },
    "release": {
      "terminal": [
        "finish"
      ],
      "nodes": {
        "approve_start": {
          "description": "The human approves cutting the line branch (recorded by `release cut` or `hotfix start`).",
          "kind": "human",
          "prompt": "approve_start.md",
          "stage": "discovery"
        },
        "sync": {
          "description": "Merge the release branch into the integration branch whenever it has commits the integration branch lacks (a hotfix line only records its tip).",
          "kind": "op",
          "op": "git.line_sync",
          "stage": "delivery",
          "workspace": true,
          "schedule": "upstream",
          "inputs": {
            "approval": {
              "from": "approve_start.summary"
            }
          },
          "outputs": {
            "merged": "sha",
            "merge_commit": "sha"
          }
        },
        "approve_finish": {
          "description": "The human approves finishing the line at the synced tip.",
          "kind": "human",
          "prompt": "approve_finish.md",
          "stage": "delivery",
          "line_complete": true,
          "review": {
            "subject": "sync"
          },
          "inputs": {
            "sync": {
              "from": "sync.merged"
            }
          }
        },
        "finish": {
          "description": "Merge the line into the production branch and back into the integration branch (and an open release branch, for a hotfix); the line branch is kept.",
          "kind": "op",
          "op": "git.line_finish",
          "stage": "delivery",
          "workspace": true,
          "line_complete": true,
          "inputs": {
            "approval": {
              "from": "approve_finish.summary"
            },
            "sync": {
              "from": "sync.merged"
            }
          },
          "outputs": {
            "production_merge": "sha",
            "back_merges": "object"
          }
        }
      }
    }
  }
}
