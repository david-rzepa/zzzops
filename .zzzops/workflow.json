{
  "schema": 1,
  "graphs": {
    "default": {
      "terminal": [
        "merge"
      ],
      "nodes": {
        "design": {
          "description": "Write the design for the goal, in light of its dependencies' reviewed designs.",
          "kind": "agent",
          "root": false,
          "capability": "architectural",
          "prompt": "design.md",
          "stage": "discovery",
          "inputs": {
            "spec": {
              "from": "goal.spec"
            },
            "dep_designs": {
              "from": "deps.design.doc"
            },
            "dep_reviews": {
              "from": "deps.review_design.summary",
              "context": true,
              "optional": true
            }
          },
          "outputs": {
            "summary": "text",
            "doc": "artifact"
          },
          "instructions": [
            "workflow",
            "rigor",
            "communication"
          ]
        },
        "review_design": {
          "description": "Independent review of the design.",
          "kind": "agent",
          "capability": "reasoning",
          "prompt": "review_design.md",
          "stage": "discovery",
          "review": {
            "subject": "design"
          },
          "inputs": {
            "spec": {
              "from": "goal.spec"
            },
            "doc": {
              "from": "design.doc"
            }
          },
          "instructions": [
            "rigor",
            "communication"
          ]
        },
        "approve_design": {
          "description": "The human approves the design (skip per goal for small, low-risk goals).",
          "kind": "human",
          "prompt": "approve_design.md",
          "stage": "discovery",
          "review": {
            "subject": "design"
          },
          "inputs": {
            "summary": {
              "from": "design.summary"
            },
            "doc": {
              "from": "design.doc"
            },
            "design_review": {
              "from": "review_design.summary",
              "context": true
            }
          }
        },
        "base": {
          "description": "Put the goal's own commits on its stack base: the integration branch, one unmerged dependency's PR head, or a combine commit of several.",
          "kind": "op",
          "op": "git.base",
          "workspace": true,
          "stage": "delivery",
          "inputs": {
            "heads": {
              "from": "deps.integrate.pr.head",
              "optional": true
            },
            "prs": {
              "from": "deps.integrate.pr",
              "context": true,
              "optional": true
            },
            "merges": {
              "from": "deps.merge.merge_commit",
              "optional": true,
              "pending": true
            },
            "design_review": {
              "from": "review_design.summary",
              "context": true
            },
            "approval": {
              "from": "approve_design.summary",
              "context": true,
              "optional": true
            }
          },
          "outputs": {
            "branch": "string",
            "base_commit": "sha",
            "stack": "list",
            "replay_map": "object",
            "replay_pos": "object"
          }
        },
        "test_design": {
          "description": "Write the tests and the commands that run them.",
          "kind": "agent",
          "capability": "reasoning",
          "prompt": "test_design.md",
          "workspace": true,
          "stage": "delivery",
          "inputs": {
            "doc": {
              "from": "design.doc"
            },
            "base": {
              "from": "base.base_commit"
            }
          },
          "outputs": {
            "tests": "checkpoint",
            "commands": "strings"
          },
          "instructions": [
            "verification"
          ]
        },
        "review_tests": {
          "description": "Independent review of the tests against the design.",
          "kind": "agent",
          "capability": "reasoning",
          "prompt": "review_tests.md",
          "stage": "delivery",
          "review": {
            "subject": "test_design"
          },
          "inputs": {
            "doc": {
              "from": "design.doc"
            },
            "tests": {
              "from": "test_design.tests.change"
            }
          },
          "instructions": [
            "verification"
          ]
        },
        "implement": {
          "description": "Implement the design so the accepted tests pass, without changing them.",
          "kind": "agent",
          "capability": "bounded",
          "prompt": "implement.md",
          "workspace": true,
          "stage": "delivery",
          "inputs": {
            "doc": {
              "from": "design.doc"
            },
            "tests": {
              "from": "test_design.tests.change"
            },
            "base": {
              "from": "base.base_commit"
            },
            "commands": {
              "from": "test_design.commands",
              "context": true
            },
            "tests_review": {
              "from": "review_tests.summary",
              "context": true
            }
          },
          "preserve": "test_design",
          "outputs": {
            "code": "checkpoint",
            "summary": "text"
          },
          "instructions": [
            "code_quality",
            "dependencies",
            "security",
            "git"
          ]
        },
        "run_tests": {
          "description": "Run the goal's test commands and the repository's verification commands on the exact code tree.",
          "kind": "op",
          "op": "checks.run",
          "workspace": true,
          "stage": "delivery",
          "inputs": {
            "code": {
              "from": "implement.code.tree"
            },
            "commands": {
              "from": "test_design.commands"
            }
          },
          "policy": [
            "verification.commands"
          ],
          "outputs": {
            "result": "object"
          }
        },
        "review_impl": {
          "description": "Independent review of the implementation.",
          "kind": "agent",
          "capability": "reasoning",
          "prompt": "review_impl.md",
          "stage": "delivery",
          "review": {
            "subject": "implement"
          },
          "inputs": {
            "doc": {
              "from": "design.doc"
            },
            "tests": {
              "from": "test_design.tests.change"
            },
            "code": {
              "from": "implement.code.change"
            },
            "checks": {
              "from": "run_tests.result",
              "context": true
            }
          },
          "instructions": [
            "code_quality",
            "security",
            "verification"
          ]
        },
        "integrate": {
          "description": "Build the review-free PR branch, open, update or retarget the PR, and read its required checks.",
          "kind": "op",
          "op": "git.integrate",
          "workspace": true,
          "stage": "delivery",
          "inputs": {
            "code": {
              "from": "implement.code.tree"
            },
            "base": {
              "from": "base.base_commit"
            },
            "stack": {
              "from": "base.stack",
              "context": true
            },
            "review": {
              "from": "review_impl.summary",
              "context": true
            },
            "summary": {
              "from": "design.summary",
              "context": true
            },
            "checks": {
              "from": "run_tests.result",
              "context": true
            }
          },
          "policy": [
            "verification.required_ci"
          ],
          "outputs": {
            "pr": "object",
            "ci": "object"
          }
        },
        "approve_merge": {
          "description": "The human decides to merge.",
          "kind": "human",
          "prompt": "approve_merge.md",
          "stage": "delivery",
          "review": {
            "subject": "implement"
          },
          "inputs": {
            "code": {
              "from": "implement.code.change"
            },
            "summary": {
              "from": "implement.summary",
              "context": true
            },
            "design_summary": {
              "from": "design.summary",
              "context": true
            },
            "tests_review": {
              "from": "review_tests.summary",
              "context": true
            },
            "impl_review": {
              "from": "review_impl.summary",
              "context": true
            }
          }
        },
        "merge": {
          "description": "Merge the PR at the expected head, once every dependency has merged.",
          "kind": "op",
          "op": "github.merge",
          "stage": "delivery",
          "release_gate": true,
          "inputs": {
            "pr": {
              "from": "integrate.pr"
            },
            "approval": {
              "from": "approve_merge.summary",
              "context": true
            },
            "dep_merges": {
              "from": "deps.merge.merge_commit",
              "context": true,
              "optional": true
            },
            "base": {
              "from": "base.base_commit",
              "context": true
            },
            "issue": {
              "from": "goal.links.issue",
              "context": true
            }
          },
          "outputs": {
            "merge_commit": "sha",
            "merged_at": "string"
          }
        }
      }
    }
  }
}
